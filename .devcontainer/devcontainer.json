{
  "name": "cfbratings",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "apps/streamlit_app.py"]
    },
    "vscode": {
      "settings": {
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip install --user -e '.[dev]' && echo 'cfbratings installed'",
  "postAttachCommand": {
    "server": "streamlit run apps/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
