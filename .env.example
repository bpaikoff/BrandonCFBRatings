# Copy to .env and fill in. Get a free key at https://collegefootballdata.com/key
CFBD_API_KEY=

# Optional overrides (defaults shown)
# CFB_YEAR=2026
# CFB_SEASON_TYPE=both          # regular | postseason | both
# CFB_CACHE_DIR=data/cache
# CFB_ARCHIVE_DIR=data/archive   # committed gzipped payloads of finished seasons (never re-fetched)
# CFB_CACHE_TTL_HOURS=6
# CFB_HFA=2.5                   # home-field advantage, points
# CFB_COLLEY_PRIOR=2.0
# CFB_MASSEY_LAMBDA=1.0
# CFB_MASSEY_MAX_MARGIN=50
# CFB_MASSEY_HALF_LIFE=0        # weeks; 0 disables recency weighting
# CFB_MASSEY_PRIOR_LAMBDA=3.0   # ridge strength toward a preseason prior
# CFB_ELO_K=25
# CFB_ELO_INIT=1500
# CFB_ELO_PER_POINT=25
# CFB_ELO_MOV=1
# CFB_SEASON_REGRESS=0.33       # fraction of last season's rating regressed to the mean (all models)
# CFB_FCS=pool                  # pool | drop  — games against FCS opponents
# CFB_BT_RIDGE=1.0
# CFB_HYBRID_WEIGHTS=colley=0.2,massey=0.6,elo=0.2
